# Root-level overrides for `docker compose` (docker-compose.yml reads a `.env`
# file next to it for ${VAR:-default} substitution — this is separate from
# backend/.env, which only matters when running uvicorn directly, not in Docker).
#
# Copy to `.env` and uncomment/edit what you need:
#   cp .env.example .env

# Devices and anomalies come only from Zenoh. Off by default: missions can
# still be authored with nothing connected.
# ZENOH_ENABLED=true
# ZENOH_ROUTER=tcp/zenohd:7447

# Where the BROWSER reaches the backend's REST/WebSocket API — override for a
# real deployment where the frontend is viewed from a different machine than
# the one Docker runs on (e.g. a robot on the local network).
# API_BASE_URL=http://robot-host:8000
# WS_URL=ws://robot-host:8000/ws
# CORS_ORIGINS=["http://robot-host:5050"]

# "mock" (default) or "real" camera streams, see frontend/src/api/cameraConfig.ts.
# CAMERA_MODE=mock

# Owner of devtools recordings in data/ (`id -u`, `id -g`) if not 1000.
# HOST_UID=1000
# HOST_GID=1000

# Anomaly history is recorded to the postgres service by default, one session
# per backend run. If Postgres is unreachable, history is dropped (logged
# once) and everything else keeps working. An empty value turns it off.
# DATABASE_URL=

# Tags the recorded history: "sim" (default) for dummy detectors, "real" for
# real perception. The heatmap only mixes history of the same source.
# ANOMALY_SOURCE=real

# Name the history is recorded under. Defaults to the map folder name
# (storage/maps/<name>/), so only set it to record under another name.
# MAP_NAME=campus

# Which recorded sources the heatmap shows (default: just ANOMALY_SOURCE).
# A demo with simulated history and real perception: ANOMALY_SOURCE=real and
# HEATMAP_SOURCES=sim,real -- recordings stay truthfully labelled.
# HEATMAP_SOURCES=sim,real

# Heatmap tuning; /dev > History > Preview > Copy config writes these.
# HEATMAP_SCALE_FLOOR=0.05
# HEATMAP_SCALE_CEILING=5
# HEATMAP_BANDWIDTH_M=4
# HEATMAP_HALF_LIFE_DAYS=21
# HEATMAP_PRIOR_HOURS=2

# Allow delete, purge, seed and scenarios in /dev > History.
# DEVTOOLS_HISTORY_WRITE=true

# Credentials for the postgres service; DATABASE_URL follows them.
# POSTGRES_DB=mission_manager
# POSTGRES_USER=mission_manager
# POSTGRES_PASSWORD=mission_manager
# Host port (loopback only), e.g. if another Postgres already uses 5432.
# POSTGRES_PORT=5432
