# Settings for `docker compose up --build`. For each deployment:
#   cp .env.example .env    then edit the lines below
# Every line is optional. With none set, the stack runs for this machine only
# (http://localhost:5050) on the nsh map, with no devices.

# Address other machines use to reach this one (IP or hostname). Set it when
# the UI is opened from another laptop: http://<PUBLIC_HOST>:5050
# PUBLIC_HOST=192.168.1.10

# Receive robots, towers and anomalies, published to this stack's zenohd (port 7447).
ZENOH_ENABLED=true

# Site map: a folder under backend/storage/maps/ (nsh, ks).
# MAP=nsh

# Owner of devtools recordings in data/ if your user isn't 1000 (`id -u`, `id -g`).
# HOST_UID=1000
# HOST_GID=1000
