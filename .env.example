# Root-level overrides for `docker compose` (docker-compose.yml reads a `.env`
# file next to it for ${VAR:-default} substitution — this is separate from
# backend/.env, which only matters when running uvicorn directly, not in Docker).
#
# Copy to `.env` and uncomment/edit what you need:
#   cp .env.example .env

# Turn on the Zenoh transport once a device_gateway (real, or its demo
# dummy_robot/iot_device) is publishing DeviceState-shaped payloads to the
# zenohd service in docker-compose.yml. Off by default -- no devices/
# anomalies show up until this is on and something is actually publishing.
# ZENOH_ENABLED=true
# ZENOH_ROUTER=tcp/zenohd:7447

# Where the BROWSER reaches the backend's REST/WebSocket API — override for a
# real deployment where the frontend is viewed from a different machine than
# the one Docker runs on (e.g. a robot on the local network).
# API_BASE_URL=http://robot-host:8000
# WS_URL=ws://robot-host:8000/ws

# "mock" (default) or "real" — see frontend/src/api/cameraConfig.ts. "real"
# requires the backend camera/WebRTC endpoints to be implemented (currently a
# stub, see backend/api/camera.py).
# CAMERA_MODE=mock

# Anomaly-history persistence (backend/core/anomaly_repository.py) is OFF by
# default -- `docker compose up` won't even start the postgres container, so
# routine dev/testing doesn't accumulate throwaway anomaly rows. Turn it on
# for a session with either of:
#   COMPOSE_PROFILES=db
#   docker compose --profile db up
# COMPOSE_PROFILES=db

# Credentials for the postgres service, only relevant once the "db" profile
# above is enabled. Defaults below match docker-compose.yml's own fallbacks,
# so this only needs uncommenting if you want different credentials. The
# backend's DATABASE_URL is derived from these automatically; there's no
# separate DATABASE_URL override here.
# POSTGRES_DB=mission_manager
# POSTGRES_USER=mission_manager
# POSTGRES_PASSWORD=mission_manager
