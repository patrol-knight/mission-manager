BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

MAP_OSM_PATH=storage/maps/lanelet2_map.osm
MAP_PROJECTOR_PATH=storage/maps/map_projector_info.yaml

MISSION_FOLDER=storage/missions
APP_STATE_PATH=storage/app_state.yaml

DEVICE_OFFLINE_TIMEOUT_SEC=3.0
DEVICE_MONITOR_INTERVAL_SEC=1.0

ZENOH_ENABLED=false
ZENOH_ROUTER=tcp/localhost:7447
ZENOH_DEVICE_STATE_KEYEXPR=mission-manager/devices/*/state

# Local demo config: the dev simulator is ON here (unlike .env.example's
# default), so the frontend has live devices/anomalies to show without real
# robots or Zenoh. Copy this file to .env to use it: `cp .env.demo .env`.
SIMULATOR_ENABLED=true
SIMULATOR_TICK_INTERVAL_SEC=0.5
SIMULATOR_ROBOT_DEVICE_ID=sim-robot-01
SIMULATOR_ROBOT_SPEED_MPS=1.0
SIMULATOR_IOT_DEVICE_IDS=["sim-iot-01","sim-iot-02","sim-iot-03"]
SIMULATOR_IOT_FLAP_MIN_SEC=15.0
SIMULATOR_IOT_FLAP_MAX_SEC=45.0
SIMULATOR_IOT_FLAP_DURATION_SEC=6.0
SIMULATOR_ANOMALY_MIN_INTERVAL_SEC=20.0
SIMULATOR_ANOMALY_MAX_INTERVAL_SEC=60.0
SIMULATOR_ANOMALY_OFFSET_M=1.5
