# Settings for running the backend outside Docker:
#   cp .env.example .env && .venv/bin/uvicorn app:app --reload
# Docker ignores this file. Every line is optional; the defaults run the nsh
# map for the Vite dev server (http://localhost:5173) with no devices.

# Receive devices and anomalies from a zenohd on this machine.
# ZENOH_ENABLED=true
# ZENOH_ROUTER=tcp/localhost:7447

# Another map from storage/maps/<name>/.
# MAP_OSM_PATH=storage/maps/ks/lanelet2_map.osm
# MAP_PROJECTOR_PATH=storage/maps/ks/map_projector_info.yaml
