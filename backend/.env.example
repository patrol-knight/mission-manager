BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

MAP_OSM_PATH=storage/maps/lanelet2_map.osm
MAP_PROJECTOR_PATH=storage/maps/map_projector_info.yaml

MISSION_FOLDER=storage/missions
APP_STATE_PATH=storage/app_state.yaml

DEVICE_OFFLINE_TIMEOUT_SEC=3.0
DEVICE_MONITOR_INTERVAL_SEC=1.0

# Devices and anomalies come only from Zenoh; leave off to author missions
# with nothing connected.
ZENOH_ENABLED=false
ZENOH_ROUTER=tcp/localhost:7447
ZENOH_DEVICE_STATE_KEYEXPR=devices/*/state

# Durable anomaly-detection history (backend/core/anomaly_repository.py).
# Unset by default -- persistence is skipped entirely and the in-memory
# anomaly workflow runs exactly as without this. Only matters for bare
# `uvicorn` dev against a Postgres you've started yourself; under Docker
# Compose this is set explicitly in docker-compose.yml instead.
# DATABASE_URL=postgresql://mission_manager:mission_manager@localhost:5432/mission_manager
# ANOMALY_SOURCE=sim
# MAP_NAME=campus
